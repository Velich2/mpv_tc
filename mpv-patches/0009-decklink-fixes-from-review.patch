+// Returns an entry to convert the next frame into, growing the ring if needed.
+// Returns -1 if the ring is full; the frame is then dropped.
+static int acquire_entry(struct dl_mirror *m)
+{
+    mp_mutex_lock(&m->lock);
+    int idx = get_free_entry(m);
+    bool grow = idx < 0 && m->num_ring < ring_limit(m);
+    mp_mutex_unlock(&m->lock);
+
+    if (grow) {
+        struct mp_image *img = alloc_output_image(&m->mode);
+        if (img) {
+            mp_mutex_lock(&m->lock);
+            MP_TARRAY_APPEND(NULL, m->ring, m->num_ring,
+                             (struct ring_entry){ .img = img });
+            idx = m->num_ring - 1;
+            mp_mutex_unlock(&m->lock);
+        }
+    }
+
+    if (idx >= 0) {
+        mp_mutex_lock(&m->lock);
+        m->ring[idx].busy = true;
+        m->ring[idx].valid = false;
+        mp_mutex_unlock(&m->lock);
+    }
+    return idx;
+}
