+// Frame rates derived from frame durations jitter; use the nearest standard
+// rate if it is close.
+static double snap_fps(double fps)
+{
+    static const double rates[] = {
+        24000 / 1001.0, 24, 25, 30000 / 1001.0, 30, 48000 / 1001.0, 48, 50,
+        60000 / 1001.0, 60, 100, 120000 / 1001.0, 120,
+    };
+    double best = fps, best_diff = INFINITY;
+    for (int n = 0; n < MP_ARRAY_SIZE(rates); n++) {
+        double diff = fabs(fps - rates[n]);
+        if (diff < rates[n] * 0.01 && diff < best_diff) {
+            best = rates[n];
+            best_diff = diff;
+        }
+    }
+    return best;
+}
+
+static int compare_double(const void *a, const void *b)
+{
+    double x = *(const double *)a, y = *(const double *)b;
+    return x < y ? -1 : x > y;
+}
