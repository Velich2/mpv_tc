+// How many converted frames may be needed at the same time: all frames due
+// within the output latency, plus a few queued ahead and being converted.
+// Call with lock held.
+static int ring_limit(struct dl_mirror *m)
+{
+    double fps = MPMAX(m->content_fps, mode_fps(&m->mode));
