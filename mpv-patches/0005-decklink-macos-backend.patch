+// DeckLink output through the Desktop Video API on macOS (scheduled playback).
+// Same logic as backend_win.c; the macOS SDK is C++ only.
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <vector>
+#include <strings.h>
+
+#include "DeckLinkAPI.h"
+
+extern "C" {
+#include "common/common.h"
+#include "common/msg.h"
+#include "mpv_talloc.h"
+#include "osdep/timer.h"
+
+#include "backend.h"
+}
+
+// Frames scheduled ahead of the one being displayed.
+#define PREROLL 3
+
+struct priv;
+
+class OutputCallback : public IDeckLinkVideoOutputCallback {
+public:
+    explicit OutputCallback(struct priv *p) : p(p) {}
+
+    HRESULT QueryInterface(REFIID iid, LPVOID *obj) override
+    {
+        CFUUIDBytes unknown = CFUUIDGetUUIDBytes(IUnknownUUID);
+        if (memcmp(&iid, &unknown, sizeof(iid)) == 0 ||
+            memcmp(&iid, &IID_IDeckLinkVideoOutputCallback, sizeof(iid)) == 0)
+        {
+            *obj = this;
+            return S_OK;
+        }
+        *obj = nullptr;
+        return E_NOINTERFACE;
+    }
+
+    // The callback object lives in struct priv, which outlives its registration.
+    ULONG AddRef() override { return 1; }
+    ULONG Release() override { return 1; }
+
+    HRESULT ScheduledFrameCompleted(IDeckLinkVideoFrame *frame,
+                                    BMDOutputFrameCompletionResult result) override;
+    HRESULT ScheduledPlaybackHasStopped() override { return S_OK; }
+
+private:
+    struct priv *p;
+};
+
+struct priv {
+    explicit priv(struct dl_output *o) : callback(this), o(o) {}
+
+    OutputCallback callback;
+    struct dl_output *o;
+    IDeckLink *device = nullptr;
+    IDeckLinkOutput *output = nullptr;
+
+    std::mutex lock;
+    bool running = false;
+    struct dl_mode mode = {};
+    int64_t frame_ns = 0;
+    IDeckLinkMutableVideoFrame *frames[PREROLL] = {};
+    int64_t frame_slot[PREROLL] = {};   // slot each frame is scheduled for
+    int64_t next_slot = 0;
+    double base = 0;                    // estimated realtime when slot 0 started
+    int late_frames = 0;
+};
+
+static char *cfstr_to_utf8(void *ta_ctx, CFStringRef s)
+{
+    if (!s)
+        return nullptr;
+    CFIndex size = CFStringGetMaximumSizeForEncoding(CFStringGetLength(s),
+                                                     kCFStringEncodingUTF8) + 1;
+    char *r = (char *)talloc_size(ta_ctx, size);
+    if (!CFStringGetCString(s, r, size, kCFStringEncodingUTF8))
+        TA_FREEP(&r);
+    CFRelease(s);
+    return r;
+}
+
+static bool contains_nocase(const char *haystack, const char *needle)
+{
+    size_t len = strlen(needle);
+    for (; *haystack; haystack++) {
+        if (strncasecmp(haystack, needle, len) == 0)
+            return true;
+    }
+    return false;
+}
+
+// Fills and schedules frames[idx] for the next slot. Call with lock held.
+static void schedule_frame(struct priv *p, int idx)
+{
+    int64_t slot = p->next_slot++;
+    p->frame_slot[idx] = slot;
+
+    IDeckLinkMutableVideoFrame *frame = p->frames[idx];
+    void *bytes = nullptr;
+    if (frame->GetBytes(&bytes) == S_OK && bytes) {
+        int64_t display_time = llrint(p->base + slot * (double)p->frame_ns);
+        dl_mirror_fill(p->o->mirror, bytes, frame->GetRowBytes(), display_time);
+    }
+    HRESULT hr = p->output->ScheduleVideoFrame(frame, slot * p->mode.duration,
+                                               p->mode.duration, p->mode.timescale);
+    if (hr != S_OK)
+        MP_WARN(p->o, "Could not schedule frame (0x%lx).\n", (unsigned long)hr);
+}
+
+static int find_frame(struct priv *p, IDeckLinkVideoFrame *frame)
+{
+    for (int n = 0; n < PREROLL; n++) {
+        if (static_cast<IDeckLinkVideoFrame *>(p->frames[n]) == frame)
+            return n;
+    }
+    return -1;
+}
+
+HRESULT OutputCallback::ScheduledFrameCompleted(IDeckLinkVideoFrame *frame,
+                                                BMDOutputFrameCompletionResult result)
+{
+    int64_t now = mp_time_ns();
+
+    std::lock_guard<std::mutex> guard(p->lock);
+    int idx = p->running && result != bmdOutputFrameFlushed ? find_frame(p, frame) : -1;
+    if (idx < 0)
+        return S_OK;
+
+    if (result == bmdOutputFrameCompleted) {
+        // The frame's slot just ended; track the card clock against ours.
+        double sample = now - (p->frame_slot[idx] + 1) * (double)p->frame_ns;
+        p->base += (sample - p->base) * 0.05;
+    } else {
+        // Displayed late or dropped: schedule further ahead.
+        if (p->late_frames++ < 10)
+            MP_VERBOSE(p->o, "Frame %s.\n",
+                       result == bmdOutputFrameDropped ? "dropped" : "late");
+        BMDTimeValue stream_time = 0;
+        double speed = 0;
+        if (p->output->GetScheduledStreamTime(p->mode.timescale, &stream_time,
+                                              &speed) == S_OK)
+        {
+            int64_t slot = stream_time / p->mode.duration + PREROLL;
+            p->next_slot = MPMAX(p->next_slot, slot);
+        }
+    }
+    schedule_frame(p, idx);
+    return S_OK;
+}
+
+static void free_frames(struct priv *p)
+{
+    for (int n = 0; n < PREROLL; n++) {
+        if (p->frames[n])
+            p->frames[n]->Release();
+        p->frames[n] = nullptr;
+    }
+}
+
+static void mac_stop(struct dl_output *o)
+{
+    struct priv *p = (struct priv *)o->priv;
+
+    {
+        std::lock_guard<std::mutex> guard(p->lock);
+        p->running = false;
+    }
+
+    p->output->StopScheduledPlayback(0, nullptr, 0);
+    p->output->SetScheduledFrameCompletionCallback(nullptr);
+    p->output->DisableVideoOutput();
+
+    // Wait for a callback that may still be running.
+    std::lock_guard<std::mutex> guard(p->lock);
+    free_frames(p);
+}
+
+static bool mac_start(struct dl_output *o, const struct dl_mode *mode)
+{
+    struct priv *p = (struct priv *)o->priv;
+
+    HRESULT hr = p->output->EnableVideoOutput(mode->id, bmdVideoOutputFlagDefault);
+    if (hr != S_OK) {
+        MP_ERR(o, "Could not enable video output (0x%lx).\n", (unsigned long)hr);
+        return false;
+    }
+
+    p->mode = *mode;
+    p->frame_ns = MP_TIME_S_TO_NS(mode->duration) / mode->timescale;
+    o->fill_ahead_ns = PREROLL * p->frame_ns;
+
+    for (int n = 0; n < PREROLL; n++) {
+        hr = p->output->CreateVideoFrame(mode->w, mode->h, mode->w * 2,
+                                         bmdFormat8BitYUV, bmdFrameFlagDefault,
+                                         &p->frames[n]);
+        if (hr != S_OK) {
+            MP_ERR(o, "Could not create video frame (0x%lx).\n", (unsigned long)hr);
+            goto error;
+        }
+    }
+
+    hr = p->output->SetScheduledFrameCompletionCallback(&p->callback);
+    if (hr != S_OK) {
+        MP_ERR(o, "Could not set callback (0x%lx).\n", (unsigned long)hr);
+        goto error;
+    }
+
+    {
+        std::lock_guard<std::mutex> guard(p->lock);
+        p->running = true;
+        p->next_slot = 0;
+        p->late_frames = 0;
+        p->base = mp_time_ns();
+        for (int n = 0; n < PREROLL; n++)
+            schedule_frame(p, n);
+    }
+
+    hr = p->output->StartScheduledPlayback(0, mode->timescale, 1.0);
+
+    {
+        std::lock_guard<std::mutex> guard(p->lock);
+        p->base = mp_time_ns();
+    }
+
+    if (hr != S_OK) {
+        MP_ERR(o, "Could not start playback (0x%lx).\n", (unsigned long)hr);
+        mac_stop(o);
+        return false;
+    }
+    return true;
+
+error:
+    p->output->SetScheduledFrameCompletionCallback(nullptr);
+    p->output->DisableVideoOutput();
+    free_frames(p);
+    return false;
+}
+
+static void mac_close(struct dl_output *o)
+{
+    struct priv *p = (struct priv *)o->priv;
+    if (!p)
+        return;
+    if (p->output)
+        p->output->Release();
+    if (p->device)
+        p->device->Release();
+    talloc_free(o->modes);
+    delete p;
+    o->priv = nullptr;
+    o->modes = nullptr;
+    o->num_modes = 0;
+}
+
+static void add_modes(struct dl_output *o)
+{
+    struct priv *p = (struct priv *)o->priv;
+    IDeckLinkDisplayModeIterator *it = nullptr;
+    if (p->output->GetDisplayModeIterator(&it) != S_OK)
+        return;
+
+    std::vector<struct dl_mode> modes;
+    IDeckLinkDisplayMode *dm = nullptr;
+    while (it->Next(&dm) == S_OK) {
+        struct dl_mode mode = {};
+        mode.id = dm->GetDisplayMode();
+        mode.w = dm->GetWidth();
+        mode.h = dm->GetHeight();
+        BMDTimeValue duration = 0;
+        BMDTimeScale timescale = 0;
+        dm->GetFrameRate(&duration, &timescale);
+        mode.duration = duration;
+        mode.timescale = timescale;
+        BMDFieldDominance field = dm->GetFieldDominance();
+        mode.interlaced = field == bmdLowerFieldFirst || field == bmdUpperFieldFirst;
+        CFStringRef name = nullptr;
+        if (dm->GetName(&name) == S_OK) {
+            char *s = cfstr_to_utf8(nullptr, name);
+            snprintf(mode.name, sizeof(mode.name), "%s", s ? s : "");
+            talloc_free(s);
+        }
+
+        BMDDisplayMode actual = 0;
+        bool supported = false;
+        HRESULT hr = p->output->DoesSupportVideoMode(bmdVideoConnectionUnspecified,
+                        mode.id, bmdFormat8BitYUV, bmdNoVideoOutputConversion,
+                        bmdSupportedVideoModeDefault, &actual, &supported);
+        if (hr == S_OK && supported && mode.duration > 0 && mode.timescale > 0 &&
+            mode.w > 0 && mode.h > 0)
+            modes.push_back(mode);
+
+        dm->Release();
+    }
+    it->Release();
+
+    o->num_modes = modes.size();
+    o->modes = (struct dl_mode *)talloc_memdup(NULL, modes.data(),
+                                              modes.size() * sizeof(modes[0]));
+}
+
+struct device_entry {
+    IDeckLink *device;
+    IDeckLinkOutput *output;
+    char *name;
+};
+
+// Lists the devices that have an output.
+static std::vector<struct device_entry> enum_devices(void *ta_ctx, struct mp_log *log)
+{
+    std::vector<struct device_entry> list;
+    IDeckLinkIterator *it = CreateDeckLinkIteratorInstance();
+    if (!it) {
+        mp_msg(log, MSGL_ERR, "Could not access DeckLink devices; is Blackmagic "
+               "Desktop Video installed?\n");
+        return list;
+    }
+
+    IDeckLink *dev = nullptr;
+    while (it->Next(&dev) == S_OK) {
+        IDeckLinkOutput *output = nullptr;
+        if (dev->QueryInterface(IID_IDeckLinkOutput, (void **)&output) != S_OK) {
+            dev->Release();
+            continue;
+        }
+        CFStringRef cfname = nullptr;
+        char *name = nullptr;
+        if (dev->GetDisplayName(&cfname) == S_OK)
+            name = cfstr_to_utf8(ta_ctx, cfname);
+        if (!name)
+            name = talloc_asprintf(ta_ctx, "DeckLink %d", (int)list.size() + 1);
+        list.push_back({dev, output, name});
+    }
+    it->Release();
+    return list;
+}
+
+static void release_devices(std::vector<struct device_entry> &list)
+{
+    for (auto &entry : list) {
+        if (entry.output)
+            entry.output->Release();
+        if (entry.device)
+            entry.device->Release();
+    }
+    list.clear();
+}
+
+// device: "auto" (first device with output), an index, the name, or part of it.
+static bool mac_open(struct dl_output *o, const char *device)
+{
+    struct priv *p = new priv(o);
+    o->priv = p;
+
+    void *tmp = talloc_new(NULL);
+    std::vector<struct device_entry> list = enum_devices(tmp, o->log);
+    int num = list.size();
+
+    int idx = -1;
+    char *end;
+    long n = strtol(device, &end, 10);
+    if (strcmp(device, "auto") == 0) {
+        idx = num > 0 ? 0 : -1;
+    } else if (end != device && !*end) {
+        idx = n >= 0 && n < num ? n : -1;
+    } else {
+        for (int i = 0; i < num && idx < 0; i++) {
+            if (strcasecmp(list[i].name, device) == 0)
+                idx = i;
+        }
+        for (int i = 0; i < num && idx < 0; i++) {
+            if (contains_nocase(list[i].name, device))
+                idx = i;
+        }
+    }
+    for (int i = 0; i < num; i++)
+        MP_VERBOSE(o, "Device %d: %s\n", i, list[i].name);
+
+    if (idx >= 0) {
+        MP_INFO(o, "Using %s.\n", list[idx].name);
+        p->device = list[idx].device;
+        p->output = list[idx].output;
+        list[idx] = {};
+    }
+    release_devices(list);
+    talloc_free(tmp);
+
+    if (!p->output) {
+        MP_ERR(o, "No DeckLink output device matching '%s' (%d found).\n",
+               device, num);
+        mac_close(o);
+        return false;
+    }
+
+    add_modes(o);
+    return true;
+}
+
+extern "C" char **dl_mac_list_devices(void *ta_ctx, int *num)
+{
+    void *tmp = talloc_new(NULL);
+    std::vector<struct device_entry> list = enum_devices(tmp, mp_null_log);
+    *num = list.size();
+    char **names = (char **)talloc_size(ta_ctx, sizeof(char *) * (*num + 1));
+    for (int n = 0; n < *num; n++)
+        names[n] = talloc_strdup(ta_ctx, list[n].name);
+    names[*num] = nullptr;
+    release_devices(list);
+    talloc_free(tmp);
+    return names;
+}
+
+extern "C" const struct dl_backend dl_backend_mac = {
+    "macos",
+    mac_open,
+    mac_start,
+    mac_stop,
+    mac_close,
+};
