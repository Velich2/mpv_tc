+#if HAVE_DECKLINK
+// (Re)creates the DeckLink mirror if its options changed.
+static void update_decklink(struct vo *vo)
+{
+    struct vo_internal *in = vo->in;
+    struct mp_vo_opts *opts = vo->opts;
+    const char *device = opts->decklink_mirror ? opts->decklink_mirror : "";
+    const char *mode = opts->decklink_mode ? opts->decklink_mode : "";
+
+    if (in->dl_device && strcmp(device, in->dl_device) == 0 &&
+        strcmp(mode, in->dl_mode) == 0 && opts->decklink_delay == in->dl_delay)
+        return;
+    talloc_replace(vo, in->dl_device, device);
+    talloc_replace(vo, in->dl_mode, mode);
+    in->dl_delay = opts->decklink_delay;
+
+    mp_mutex_lock(&in->lock);
+    struct dl_mirror *old = in->dl_mirror;
+    in->dl_mirror = NULL;
+    mp_mutex_unlock(&in->lock);
+    dl_mirror_destroy(old);
+
+    if (!device[0])
+        return;
+    struct dl_mirror *m = dl_mirror_create(vo->global);
+    mp_mutex_lock(&in->lock);
+    in->dl_mirror = m;
+    // Show the current frame right away, e.g. when enabled while paused.
+    if (m && in->current_frame && in->current_frame->current) {
+        dl_mirror_queue(m, in->current_frame->current, 0,
+                        in->current_frame->duration);
+    }
+    mp_mutex_unlock(&in->lock);
+}
+
+static void run_update_decklink(void *p)
+{
+    update_decklink(p);
+}
+#endif
