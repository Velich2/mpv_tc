diff --git a/player/lua/select.lua b/player/lua/select.lua
index 38f29cd..2029bfd 100644
--- a/player/lua/select.lua
+++ b/player/lua/select.lua
@@ -413,6 +413,73 @@ mp.add_key_binding(nil, "select-audio-device", function ()
     })
 end)
 
+local decklink_state = "~~/decklink.state"
+
+local function decklink_supported()
+    return mp.get_property("option-info/decklink-mirror") ~= nil
+end
+
+-- Restore the DeckLink output chosen in the menu, unless it was set otherwise.
+if decklink_supported() and mp.get_property_bool("config") and
+   mp.get_property("decklink-mirror") == "" then
+    local file = io.open(mp.command_native({"expand-path", decklink_state}))
+    if file then
+        local device = file:read("*l")
+        file:close()
+        if device and device ~= "" then
+            mp.set_property("decklink-mirror", device)
+        end
+    end
+end
+
+local function save_decklink(device)
+    if not mp.get_property_bool("config") then
+        return
+    end
+    local path = mp.command_native({"expand-path", decklink_state})
+    local file, error_message = io.open(path, "w")
+    if not file then
+        show_error(error_message)
+        return
+    end
+    file:write(device, "\n")
+    file:close()
+end
+
+mp.add_key_binding(nil, "select-decklink", function ()
+    local current = mp.get_property("decklink-mirror")
+    local items = {"Off", "Auto (first device)"}
+    local devices = {"", "auto"}
+
+    for _, device in ipairs(mp.get_property_native("decklink-devices", {})) do
+        items[#items + 1] = device.name
+        devices[#devices + 1] = device.name
+    end
+
+    if #devices == 2 and current == "" then
+        show_warning("No DeckLink devices found.")
+        return
+    end
+
+    local default_item = 1
+    for i, device in ipairs(devices) do
+        if device == current then
+            default_item = i
+        end
+    end
+
+    input.select({
+        prompt = "DeckLink output:",
+        items = items,
+        default_item = default_item,
+        submit = function (id)
+            mp.set_property("decklink-mirror", devices[id])
+            save_decklink(devices[id])
+            mp.osd_message("DeckLink output: " .. (id == 1 and "off" or items[id]))
+        end,
+    })
+end)
