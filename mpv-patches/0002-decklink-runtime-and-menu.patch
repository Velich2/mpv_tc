+// device: "auto" (first device with output), an index, the name, or part of it.
+static bool win_open(struct dl_output *o, const char *device)
+{
+    struct priv *p = o->priv = talloc_zero(NULL, struct priv);
+    p->o = o;
+    p->callback.lpVtbl = &callback_vtbl;
+    mp_mutex_init(&p->lock);
+    p->com_init = SUCCEEDED(CoInitializeEx(NULL, COINIT_MULTITHREADED));
+
+    void *tmp = talloc_new(NULL);
+    struct device_entry *list;
+    int num = enum_devices(tmp, o->log, &list);
+
+    int idx = -1;
+    char *end;
+    long n = strtol(device, &end, 10);
+    if (strcmp(device, "auto") == 0) {
+        idx = num > 0 ? 0 : -1;
+    } else if (end != device && !*end) {
+        idx = n >= 0 && n < num ? n : -1;
+    } else {
+        for (int i = 0; i < num && idx < 0; i++) {
+            if (strcasecmp(list[i].name, device) == 0)
+                idx = i;
+        }
+        for (int i = 0; i < num && idx < 0; i++) {
+            if (contains_nocase(list[i].name, device))
+                idx = i;
+        }
+    }
+    for (int i = 0; i < num; i++)
+        MP_VERBOSE(o, "Device %d: %s\n", i, list[i].name);
+
+    if (idx >= 0) {
+        MP_INFO(o, "Using %s.\n", list[idx].name);
+        p->device = list[idx].device;
+        p->output = list[idx].output;
+        list[idx] = (struct device_entry){0};
+    }
+    release_devices(list, num);
+    talloc_free(tmp);
 
     if (!p->output) {
         MP_ERR(o, "No DeckLink output device matching '%s' (%d found).\n",
-               device, count);
-        goto error;
+               device, num);
+        win_close(o);
+        return false;
     }
 
     add_modes(o);
     return true;
+}
 
