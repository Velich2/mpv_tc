+static void release_devices(struct device_entry *list, int num)
+{
+    for (int n = 0; n < num; n++) {
+        if (list[n].output)
+            IDeckLinkOutput_Release(list[n].output);
+        if (list[n].device)
+            IDeckLink_Release(list[n].device);
+    }
