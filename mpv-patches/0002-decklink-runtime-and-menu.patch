-    return false;
+struct list_ctx {
+    void *ta_ctx;
+    char **names;
+    int num;
+};
+
+static MP_THREAD_VOID list_thread(void *ptr)
+{
+    struct list_ctx *ctx = ptr;
+    bool com_init = SUCCEEDED(CoInitializeEx(NULL, COINIT_MULTITHREADED));
+    void *tmp = talloc_new(NULL);
+    struct device_entry *list;
+    int num = enum_devices(tmp, mp_null_log, &list);
+    for (int n = 0; n < num; n++) {
+        MP_TARRAY_APPEND(ctx->ta_ctx, ctx->names, ctx->num,
+                         talloc_strdup(ctx->ta_ctx, list[n].name));
+    }
+    release_devices(list, num);
+    talloc_free(tmp);
+    if (com_init)
+        CoUninitialize();
+    MP_THREAD_RETURN();
+}
+
+// Runs on a separate thread to keep COM off the caller's thread.
+char **dl_win_list_devices(void *ta_ctx, int *num)
+{
+    struct list_ctx ctx = { .ta_ctx = ta_ctx };
+    mp_thread thread;
+    if (!mp_thread_create(&thread, list_thread, &ctx))
+        mp_thread_join(thread);
+    *num = ctx.num;
+    return ctx.names;
 }
 
