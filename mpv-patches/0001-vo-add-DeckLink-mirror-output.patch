+
+// DeckLink output through the Desktop Video COM API (scheduled playback).
+
+#define COBJMACROS
+#include <windows.h>
+#include <initguid.h>
+#include <objbase.h>
+#include <oleauto.h>
+
+#include "DeckLinkAPI.h"
+
+#include <ctype.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "common/common.h"
+#include "common/msg.h"
+#include "mpv_talloc.h"
+#include "osdep/io.h"
+#include "osdep/threads.h"
+#include "osdep/timer.h"
+
+#include "backend.h"
+
+// Frames scheduled ahead of the one being displayed.
+#define PREROLL 3
+
+struct priv {
+    IDeckLinkVideoOutputCallback callback;
+    struct dl_output *o;
+    bool com_init;
+    IDeckLink *device;
+    IDeckLinkOutput *output;
+
+    mp_mutex lock;
+    bool running;
+    struct dl_mode mode;
+    int64_t frame_ns;
+    IDeckLinkMutableVideoFrame *frames[PREROLL];
+    int64_t frame_slot[PREROLL];    // slot each frame is scheduled for
+    int64_t next_slot;
+    double base;                    // estimated realtime when slot 0 started
+    int late_frames;
+};
+
+static struct priv *get_priv(IDeckLinkVideoOutputCallback *cb)
+{
+    return (struct priv *)((char *)cb - offsetof(struct priv, callback));
+}
+
+static char *bstr_to_utf8(void *ta_ctx, BSTR s)
+{
+    char *r = s ? mp_to_utf8(ta_ctx, s) : NULL;
+    SysFreeString(s);
+    return r;
+}
+
+static bool contains_nocase(const char *haystack, const char *needle)
+{
+    size_t len = strlen(needle);
+    for (; *haystack; haystack++) {
+        size_t n = 0;
+        while (n < len && haystack[n] &&
+               tolower((unsigned char)haystack[n]) == tolower((unsigned char)needle[n]))
+            n++;
+        if (n == len)
+            return true;
+    }
+    return false;
+}
+
+// Fills and schedules frames[idx] for the next slot. Call with lock held.
+static void schedule_frame(struct priv *p, int idx)
+{
+    int64_t slot = p->next_slot++;
+    p->frame_slot[idx] = slot;
+
+    IDeckLinkMutableVideoFrame *frame = p->frames[idx];
+    void *bytes = NULL;
+    if (SUCCEEDED(IDeckLinkMutableVideoFrame_GetBytes(frame, &bytes)) && bytes) {
+        int64_t display_time = llrint(p->base + slot * (double)p->frame_ns);
+        dl_mirror_fill(p->o->mirror, bytes,
+                       IDeckLinkMutableVideoFrame_GetRowBytes(frame), display_time);
+    }
+    HRESULT hr = IDeckLinkOutput_ScheduleVideoFrame(p->output,
+                    (IDeckLinkVideoFrame *)frame, slot * p->mode.duration,
+                    p->mode.duration, p->mode.timescale);
+    if (FAILED(hr))
+        MP_WARN(p->o, "Could not schedule frame (0x%lx).\n", (unsigned long)hr);
+}
+
+static int find_frame(struct priv *p, IDeckLinkVideoFrame *frame)
+{
+    for (int n = 0; n < PREROLL; n++) {
+        if ((IDeckLinkVideoFrame *)p->frames[n] == frame)
+            return n;
+    }
+    IDeckLinkMutableVideoFrame *mut = NULL;
+    if (FAILED(IDeckLinkVideoFrame_QueryInterface(frame,
+                    &IID_IDeckLinkMutableVideoFrame, (void **)&mut)))
+        return -1;
+    int idx = -1;
+    for (int n = 0; n < PREROLL; n++) {
+        if (p->frames[n] == mut)
+            idx = n;
+    }
+    IDeckLinkMutableVideoFrame_Release(mut);
+    return idx;
+}
+
+static HRESULT STDMETHODCALLTYPE cb_QueryInterface(IDeckLinkVideoOutputCallback *self,
+                                                   REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) ||
+        IsEqualIID(riid, &IID_IDeckLinkVideoOutputCallback))
+    {
+        *obj = self;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+// The callback object lives in struct priv, which outlives its registration.
+static ULONG STDMETHODCALLTYPE cb_AddRef(IDeckLinkVideoOutputCallback *self)
+{
+    return 1;
+}
+
+static ULONG STDMETHODCALLTYPE cb_Release(IDeckLinkVideoOutputCallback *self)
+{
+    return 1;
+}
+
+static HRESULT STDMETHODCALLTYPE cb_ScheduledFrameCompleted(
+    IDeckLinkVideoOutputCallback *self, IDeckLinkVideoFrame *frame,
+    BMDOutputFrameCompletionResult result)
+{
+    struct priv *p = get_priv(self);
+    int64_t now = mp_time_ns();
+
+    mp_mutex_lock(&p->lock);
+    int idx = p->running && result != bmdOutputFrameFlushed ? find_frame(p, frame) : -1;
+    if (idx < 0)
+        goto done;
+
+    if (result == bmdOutputFrameCompleted) {
+        // The frame's slot just ended; track the card clock against ours.
+        double sample = now - (p->frame_slot[idx] + 1) * (double)p->frame_ns;
+        p->base += (sample - p->base) * 0.05;
+    } else {
+        // Displayed late or dropped: schedule further ahead.
+        if (p->late_frames++ < 10)
+            MP_VERBOSE(p->o, "Frame %s.\n",
+                       result == bmdOutputFrameDropped ? "dropped" : "late");
+        BMDTimeValue stream_time = 0;
+        double speed = 0;
+        if (SUCCEEDED(IDeckLinkOutput_GetScheduledStreamTime(p->output,
+                        p->mode.timescale, &stream_time, &speed)))
+        {
+            int64_t slot = stream_time / p->mode.duration + PREROLL;
+            p->next_slot = MPMAX(p->next_slot, slot);
+        }
+    }
+    schedule_frame(p, idx);
+
+done:
+    mp_mutex_unlock(&p->lock);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE cb_ScheduledPlaybackHasStopped(
+    IDeckLinkVideoOutputCallback *self)
+{
+    return S_OK;
+}
+
+static IDeckLinkVideoOutputCallbackVtbl callback_vtbl = {
+    .QueryInterface = cb_QueryInterface,
+    .AddRef = cb_AddRef,
+    .Release = cb_Release,
+    .ScheduledFrameCompleted = cb_ScheduledFrameCompleted,
+    .ScheduledPlaybackHasStopped = cb_ScheduledPlaybackHasStopped,
+};
+
+static void free_frames(struct priv *p)
+{
+    for (int n = 0; n < PREROLL; n++) {
+        if (p->frames[n])
+            IDeckLinkMutableVideoFrame_Release(p->frames[n]);
+        p->frames[n] = NULL;
+    }
+}
+
+static void win_stop(struct dl_output *o)
+{
+    struct priv *p = o->priv;
+
+    mp_mutex_lock(&p->lock);
+    p->running = false;
+    mp_mutex_unlock(&p->lock);
+
+    IDeckLinkOutput_StopScheduledPlayback(p->output, 0, NULL, 0);
+    IDeckLinkOutput_SetScheduledFrameCompletionCallback(p->output, NULL);
+    IDeckLinkOutput_DisableVideoOutput(p->output);
+
+    // Wait for a callback that may still be running.
+    mp_mutex_lock(&p->lock);
+    free_frames(p);
+    mp_mutex_unlock(&p->lock);
+}
+
+static bool win_start(struct dl_output *o, const struct dl_mode *mode)
+{
+    struct priv *p = o->priv;
+
+    HRESULT hr = IDeckLinkOutput_EnableVideoOutput(p->output, mode->id,
+                                                   bmdVideoOutputFlagDefault);
+    if (FAILED(hr)) {
+        MP_ERR(o, "Could not enable video output (0x%lx).\n", (unsigned long)hr);
+        return false;
+    }
+
+    p->mode = *mode;
+    p->frame_ns = MP_TIME_S_TO_NS(mode->duration) / mode->timescale;
+    o->fill_ahead_ns = PREROLL * p->frame_ns;
+
+    for (int n = 0; n < PREROLL; n++) {
+        hr = IDeckLinkOutput_CreateVideoFrame(p->output, mode->w, mode->h,
+                    mode->w * 2, bmdFormat8BitYUV, bmdFrameFlagDefault,
+                    &p->frames[n]);
+        if (FAILED(hr)) {
+            MP_ERR(o, "Could not create video frame (0x%lx).\n", (unsigned long)hr);
+            goto error;
+        }
+    }
+
+    hr = IDeckLinkOutput_SetScheduledFrameCompletionCallback(p->output, &p->callback);
+    if (FAILED(hr)) {
+        MP_ERR(o, "Could not set callback (0x%lx).\n", (unsigned long)hr);
+        goto error;
+    }
+
+    mp_mutex_lock(&p->lock);
+    p->running = true;
+    p->next_slot = 0;
+    p->late_frames = 0;
+    p->base = mp_time_ns();
+    for (int n = 0; n < PREROLL; n++)
+        schedule_frame(p, n);
+    mp_mutex_unlock(&p->lock);
+
+    hr = IDeckLinkOutput_StartScheduledPlayback(p->output, 0, mode->timescale, 1.0);
+
+    mp_mutex_lock(&p->lock);
+    p->base = mp_time_ns();
+    mp_mutex_unlock(&p->lock);
+
+    if (FAILED(hr)) {
+        MP_ERR(o, "Could not start playback (0x%lx).\n", (unsigned long)hr);
+        win_stop(o);
+        return false;
+    }
+    return true;
+
+error:
+    IDeckLinkOutput_SetScheduledFrameCompletionCallback(p->output, NULL);
+    IDeckLinkOutput_DisableVideoOutput(p->output);
+    free_frames(p);
+    return false;
+}
+
+static void win_close(struct dl_output *o)
+{
+    struct priv *p = o->priv;
+    if (!p)
+        return;
+    if (p->output)
+        IDeckLinkOutput_Release(p->output);
+    if (p->device)
+        IDeckLink_Release(p->device);
+    if (p->com_init)
+        CoUninitialize();
+    mp_mutex_destroy(&p->lock);
+    TA_FREEP(&o->priv);
+    o->modes = NULL;
+    o->num_modes = 0;
+}
+
+static void add_modes(struct dl_output *o)
+{
+    struct priv *p = o->priv;
+    IDeckLinkDisplayModeIterator *it = NULL;
+    if (FAILED(IDeckLinkOutput_GetDisplayModeIterator(p->output, &it)))
+        return;
+
+    IDeckLinkDisplayMode *dm = NULL;
+    while (IDeckLinkDisplayModeIterator_Next(it, &dm) == S_OK) {
+        struct dl_mode mode = {
+            .id = IDeckLinkDisplayMode_GetDisplayMode(dm),
+            .w = IDeckLinkDisplayMode_GetWidth(dm),
+            .h = IDeckLinkDisplayMode_GetHeight(dm),
+        };
+        BMDTimeValue duration = 0;
+        BMDTimeScale timescale = 0;
+        IDeckLinkDisplayMode_GetFrameRate(dm, &duration, &timescale);
+        mode.duration = duration;
+        mode.timescale = timescale;
+        BMDFieldDominance field = IDeckLinkDisplayMode_GetFieldDominance(dm);
+        mode.interlaced = field == bmdLowerFieldFirst || field == bmdUpperFieldFirst;
+        BSTR name = NULL;
+        if (SUCCEEDED(IDeckLinkDisplayMode_GetName(dm, &name))) {
+            char *s = bstr_to_utf8(NULL, name);
+            snprintf(mode.name, sizeof(mode.name), "%s", s ? s : "");
+            talloc_free(s);
+        }
+
+        BMDDisplayMode actual = 0;
+        BOOL supported = FALSE;
+        HRESULT hr = IDeckLinkOutput_DoesSupportVideoMode(p->output,
+                        bmdVideoConnectionUnspecified, mode.id, bmdFormat8BitYUV,
+                        bmdNoVideoOutputConversion, bmdSupportedVideoModeDefault,
+                        &actual, &supported);
+        if (SUCCEEDED(hr) && supported && mode.duration > 0 && mode.timescale > 0 &&
+            mode.w > 0 && mode.h > 0)
+            MP_TARRAY_APPEND(p, o->modes, o->num_modes, mode);
+
+        IDeckLinkDisplayMode_Release(dm);
+    }
+    IDeckLinkDisplayModeIterator_Release(it);
+}
+
+// device: "auto" (first device with output), an index, or part of the name.
+static bool win_open(struct dl_output *o, const char *device)
+{
+    struct priv *p = o->priv = talloc_zero(NULL, struct priv);
+    p->o = o;
+    p->callback.lpVtbl = &callback_vtbl;
+    mp_mutex_init(&p->lock);
+    p->com_init = SUCCEEDED(CoInitializeEx(NULL, COINIT_MULTITHREADED));
+
+    IDeckLinkIterator *it = NULL;
+    HRESULT hr = CoCreateInstance(&CLSID_CDeckLinkIterator, NULL, CLSCTX_ALL,
+                                  &IID_IDeckLinkIterator, (void **)&it);
+    if (FAILED(hr)) {
+        MP_ERR(o, "Could not access DeckLink devices; is Blackmagic Desktop "
+               "Video installed? (0x%lx)\n", (unsigned long)hr);
+        goto error;
+    }
+
+    int index = -1;
+    if (strcmp(device, "auto") == 0) {
+        index = 0;
+    } else {
+        char *end;
+        long n = strtol(device, &end, 10);
+        if (end != device && !*end && n >= 0)
+            index = n;
+    }
+
+    IDeckLink *dev = NULL;
+    int count = 0;
+    while (IDeckLinkIterator_Next(it, &dev) == S_OK) {
+        IDeckLinkOutput *output = NULL;
+        if (FAILED(IDeckLink_QueryInterface(dev, &IID_IDeckLinkOutput,
+                                            (void **)&output)))
+        {
+            IDeckLink_Release(dev);
+            continue;
+        }
+        BSTR bname = NULL;
+        char *name = NULL;
+        if (SUCCEEDED(IDeckLink_GetDisplayName(dev, &bname)))
+            name = bstr_to_utf8(NULL, bname);
+        MP_VERBOSE(o, "Device %d: %s\n", count, name ? name : "?");
+
+        bool match = index >= 0 ? count == index
+                                : name && contains_nocase(name, device);
+        if (match && !p->output) {
+            MP_INFO(o, "Using %s.\n", name ? name : "DeckLink device");
+            p->device = dev;
+            p->output = output;
+        } else {
+            IDeckLinkOutput_Release(output);
+            IDeckLink_Release(dev);
+        }
+        talloc_free(name);
+        count++;
+    }
+    IDeckLinkIterator_Release(it);
+
+    if (!p->output) {
+        MP_ERR(o, "No DeckLink output device matching '%s' (%d found).\n",
+               device, count);
+        goto error;
+    }
+
+    add_modes(o);
+    return true;
+
+error:
+    win_close(o);
+    return false;
+}
+
+const struct dl_backend dl_backend_win = {
+    .name = "win32",
+    .open = win_open,
+    .start = win_start,
+    .stop = win_stop,
+    .close = win_close,
+};
diff --git a/video/out/decklink/mirror.c b/video/out/decklink/mirror.c
new file mode 100644
index 0000000..9cde04b
--- /dev/null
+++ b/video/out/decklink/mirror.c
@@ -0,0 +1,562 @@
