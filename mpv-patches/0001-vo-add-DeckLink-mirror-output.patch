+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+// Mirrors the video frames shown by the VO (without OSD) to a Blackmagic
+// DeckLink output. The card runs on its own clock; for every output slot the
+// frame whose display time was due a fixed latency earlier is picked.
+
+struct dl_mirror;
+struct mp_image;
+struct mpv_global;
+struct mp_log;
+
+struct dl_mirror *dl_mirror_create(struct mpv_global *global,
+                                   struct mp_log *log);
+void dl_mirror_destroy(struct dl_mirror *m);
+
+// Called for every new frame queued to the VO. target is the realtime (in
+// mp_time_ns() units) at which the frame is shown, or 0 for "now". duration
+// is the approximate frame duration in ns (<= 0 if unknown).
+void dl_mirror_queue(struct dl_mirror *m, struct mp_image *img,
+                     int64_t target, double duration);
