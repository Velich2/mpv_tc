+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+struct dl_mirror;
+struct mp_log;
+
+struct dl_mode {
+    char name[64];          // name reported by the device
+    uint32_t id;            // backend specific mode ID
+    int w, h;
+    int64_t duration;       // frame duration in timescale units
+    int64_t timescale;      // fps = timescale / duration
+    bool interlaced;
+};
+
+struct dl_output {
+    struct mp_log *log;
+    struct dl_mirror *mirror;
+    // Set by open().
+    struct dl_mode *modes;
+    int num_modes;
+    // Set by start(): how much earlier than its display time a slot is filled.
+    int64_t fill_ahead_ns;
+    void *priv;
+};
+
+// Output frames are 8 bit 4:2:2 YUV (UYVY). Every output slot is filled from
+// a backend thread with dl_mirror_fill(); display_time is the realtime (in
+// mp_time_ns() units) at which the slot is shown. Returns the pts of the
+// frame used, or MP_NOPTS_VALUE if black was output.
+double dl_mirror_fill(struct dl_mirror *m, void *dst, ptrdiff_t stride,
+                      int64_t display_time);
+
+struct dl_backend {
+    const char *name;
+    bool (*open)(struct dl_output *o, const char *device);
+    bool (*start)(struct dl_output *o, const struct dl_mode *mode);
+    // Must not return while dl_mirror_fill() is still being called.
+    void (*stop)(struct dl_output *o);
+    void (*close)(struct dl_output *o);
+};
+
+extern const struct dl_backend dl_backend_dummy;
+extern const struct dl_backend dl_backend_win;
diff --git a/video/out/decklink/backend_dummy.c b/video/out/decklink/backend_dummy.c
new file mode 100644
index 0000000..6dfa303
--- /dev/null
+++ b/video/out/decklink/backend_dummy.c
@@ -0,0 +1,158 @@
+/*
+ * This file is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * mpv is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+// Simulated DeckLink device for testing without hardware:
+//   --decklink-mirror=dummy             log the frame used for every slot (-v)
+//   --decklink-mirror=dummy:<file>      also write the output as raw UYVY
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "common/common.h"
+#include "common/msg.h"
+#include "mpv_talloc.h"
+#include "osdep/threads.h"
+#include "osdep/timer.h"
+
+#include "backend.h"
+
+#define PREROLL 3
+
+#define MODE_ID(a, b, c, d) (((uint32_t)(a) << 24) | ((b) << 16) | ((c) << 8) | (d))
+
+static const struct dl_mode modes[] = {
+    {"NTSC",            MODE_ID('n','t','s','c'), 720,  486,  1001, 30000, true},
+    {"PAL",             MODE_ID('p','a','l',' '), 720,  576,  1000, 25000, true},
+    {"HD 720p 50",      MODE_ID('h','p','5','0'), 1280, 720,  1000, 50000},
+    {"HD 720p 59.94",   MODE_ID('h','p','5','9'), 1280, 720,  1001, 60000},
+    {"HD 1080p 23.98",  MODE_ID('2','3','p','s'), 1920, 1080, 1001, 24000},
+    {"HD 1080p 24",     MODE_ID('2','4','p','s'), 1920, 1080, 1000, 24000},
+    {"HD 1080p 25",     MODE_ID('H','p','2','5'), 1920, 1080, 1000, 25000},
+    {"HD 1080p 29.97",  MODE_ID('H','p','2','9'), 1920, 1080, 1001, 30000},
+    {"HD 1080p 30",     MODE_ID('H','p','3','0'), 1920, 1080, 1000, 30000},
+    {"HD 1080i 50",     MODE_ID('H','i','5','0'), 1920, 1080, 1000, 25000, true},
+    {"HD 1080i 59.94",  MODE_ID('H','i','5','9'), 1920, 1080, 1001, 30000, true},
+    {"HD 1080p 50",     MODE_ID('H','p','5','0'), 1920, 1080, 1000, 50000},
+    {"HD 1080p 59.94",  MODE_ID('H','p','5','9'), 1920, 1080, 1001, 60000},
+    {"HD 1080p 60",     MODE_ID('H','p','6','0'), 1920, 1080, 1000, 60000},
+    {"4K 2160p 25",     MODE_ID('4','k','2','5'), 3840, 2160, 1000, 25000},
+    {"4K 2160p 50",     MODE_ID('4','k','5','0'), 3840, 2160, 1000, 50000},
+};
+
+struct priv {
+    char *dump_path;
+    FILE *dump;
+    uint8_t *buf;
+    struct dl_mode mode;
+    mp_thread thread;
+    mp_mutex lock;
+    mp_cond wakeup;
+    bool running;
+};
+
+static MP_THREAD_VOID slot_thread(void *ptr)
+{
+    struct dl_output *o = ptr;
+    struct priv *p = o->priv;
+    mp_thread_set_name("decklink-dummy");
+
+    int64_t frame_ns = MP_TIME_S_TO_NS(p->mode.duration) / p->mode.timescale;
+    ptrdiff_t stride = p->mode.w * 2;
+    int64_t start = mp_time_ns();
+
+    mp_mutex_lock(&p->lock);
+    for (int64_t n = 0; p->running; n++) {
+        int64_t fill_time = start + n * frame_ns;
+        while (p->running && mp_time_ns() < fill_time)
+            mp_cond_timedwait_until(&p->wakeup, &p->lock, fill_time);
+        if (!p->running)
+            break;
+        mp_mutex_unlock(&p->lock);
+
+        int64_t display_time = fill_time + o->fill_ahead_ns;
+        double pts = dl_mirror_fill(o->mirror, p->buf, stride, display_time);
+        MP_VERBOSE(o, "slot %" PRId64 " pts %f\n", n, pts);
+        if (p->dump)
+            fwrite(p->buf, stride, p->mode.h, p->dump);
+
+        mp_mutex_lock(&p->lock);
+    }
+    mp_mutex_unlock(&p->lock);
+    MP_THREAD_RETURN();
+}
+
+static bool dummy_open(struct dl_output *o, const char *device)
+{
+    struct priv *p = o->priv = talloc_zero(NULL, struct priv);
+    const char *sep = strchr(device, ':');
+    if (sep && sep[1])
+        p->dump_path = talloc_strdup(p, sep + 1);
+    o->modes = talloc_memdup(p, (void *)modes, sizeof(modes));
+    o->num_modes = MP_ARRAY_SIZE(modes);
+    mp_mutex_init(&p->lock);
+    mp_cond_init(&p->wakeup);
+    return true;
+}
+
+static bool dummy_start(struct dl_output *o, const struct dl_mode *mode)
+{
+    struct priv *p = o->priv;
+    p->mode = *mode;
+    p->buf = talloc_size(p, mode->w * 2 * mode->h);
+    o->fill_ahead_ns = PREROLL * MP_TIME_S_TO_NS(mode->duration) / mode->timescale;
+    if (p->dump_path && !p->dump) {
+        p->dump = fopen(p->dump_path, "wb");
+        if (!p->dump)
+            MP_ERR(o, "Could not open %s\n", p->dump_path);
+    }
+    p->running = true;
+    if (mp_thread_create(&p->thread, slot_thread, o)) {
+        p->running = false;
+        return false;
+    }
+    return true;
+}
+
+static void dummy_stop(struct dl_output *o)
+{
+    struct priv *p = o->priv;
+    mp_mutex_lock(&p->lock);
+    p->running = false;
+    mp_cond_signal(&p->wakeup);
+    mp_mutex_unlock(&p->lock);
+    mp_thread_join(p->thread);
+    TA_FREEP(&p->buf);
+}
+
+static void dummy_close(struct dl_output *o)
+{
+    struct priv *p = o->priv;
+    if (p->dump)
+        fclose(p->dump);
+    mp_cond_destroy(&p->wakeup);
+    mp_mutex_destroy(&p->lock);
+    TA_FREEP(&o->priv);
+}
+
+const struct dl_backend dl_backend_dummy = {
+    .name = "dummy",
+    .open = dummy_open,
+    .start = dummy_start,
+    .stop = dummy_stop,
+    .close = dummy_close,
+};
