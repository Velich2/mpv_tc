+ */
+
+#include <math.h>
+#include <string.h>
+#include <strings.h>
+
+#include "common/common.h"
+#include "common/msg.h"
+#include "mpv_talloc.h"
+#include "options/m_config.h"
+#include "options/options.h"
+#include "osdep/threads.h"
+#include "osdep/timer.h"
+#include "video/mp_image.h"
+#include "video/mp_image_pool.h"
+#include "video/sws_utils.h"
+
+#include "backend.h"
+#include "mirror.h"
+
+#define RING_SIZE 6
+#define MAX_PENDING 2
+
+// Extra time a frame must have been due before it is picked for a slot, to
+// cover jitter of the VO queue and the conversion time.
+#define MARGIN_NS MP_TIME_MS_TO_NS(10)
+
+struct ring_entry {
+    struct mp_image *img;   // UYVY in output mode size
+    int64_t target;         // realtime at which the VO shows the frame
+    double pts;
+    bool valid;
+    bool busy;              // being written by the worker
+};
+
+struct pending {
+    struct mp_image *img;
+    int64_t target;
+    double duration;
+};
+
+struct dl_mirror {
+    struct mpv_global *global;
+    struct mp_log *log;
+    struct mp_vo_opts *opts;
+    const struct dl_backend *backend;
+    struct dl_output out;
+    struct mp_sws_context *sws;
+    int64_t delay_ns;
+
+    // Worker thread only.
+    bool opened, started, failed;
+    struct dl_mode mode;
+    int content_w, content_h;
+    double content_fps;
+
+    mp_thread thread;
+    mp_mutex lock;
+    mp_cond wakeup;
+    bool terminate;
+    struct pending pending[MAX_PENDING];
+    int num_pending;
+    struct ring_entry ring[RING_SIZE];
+};
+
+static double mode_fps(const struct dl_mode *mode)
+{
+    return mode->duration > 0 ? mode->timescale / (double)mode->duration : 0;
+}
+
+static void format_rate(char *buf, size_t size, double rate)
+{
+    if (fabs(rate - lrint(rate)) < 0.005) {
+        snprintf(buf, size, "%ld", lrint(rate));
+    } else {
+        snprintf(buf, size, "%.2f", rate);
+    }
+}
+
+// "1080p25", "1080i50" (field rate), independent of the device's own names.
+static void mode_short_name(const struct dl_mode *mode, char *buf, size_t size)
+{
+    char rate[16];
+    double fps = mode_fps(mode);
+    format_rate(rate, sizeof(rate), mode->interlaced ? fps * 2 : fps);
+    snprintf(buf, size, "%d%c%s", mode->h, mode->interlaced ? 'i' : 'p', rate);
+}
+
+static void mode_code(const struct dl_mode *mode, char buf[5])
+{
+    for (int n = 0; n < 4; n++) {
+        char c = (mode->id >> (24 - n * 8)) & 0xFF;
+        buf[n] = c >= 32 && c < 127 ? c : '?';
+    }
+    buf[4] = '\0';
+}
+
+static void list_modes(struct dl_mirror *m, int level)
+{
+    mp_msg(m->log, level, "Output modes (--decklink-mode):\n");
+    for (int n = 0; n < m->out.num_modes; n++) {
+        struct dl_mode *mode = &m->out.modes[n];
+        char code[5], name[32];
+        mode_code(mode, code);
+        mode_short_name(mode, name, sizeof(name));
+        mp_msg(m->log, level, "  %-10s %-5s %dx%d  %s\n", name, code,
+               mode->w, mode->h, mode->name);
+    }
+}
+
+static const struct dl_mode *find_user_mode(struct dl_mirror *m, const char *s)
+{
+    for (int n = 0; n < m->out.num_modes; n++) {
+        struct dl_mode *mode = &m->out.modes[n];
+        char code[5], name[32];
+        mode_code(mode, code);
+        mode_short_name(mode, name, sizeof(name));
+        if (strcasecmp(s, name) == 0 || strcmp(s, code) == 0 ||
+            strcasecmp(s, mode->name) == 0)
+            return mode;
+    }
+    return NULL;
+}
+
+static int standard_width(int h)
+{
+    switch (h) {
+    case 720:  return 1280;
+    case 1080: return 1920;
+    case 2160: return 3840;
+    case 4320: return 7680;
+    }
+    return 0;
+}
+
+// Index of the smallest standard height the content fits into.
+static int fit_index(int w, int h)
+{
+    static const int heights[] = {720, 1080, 2160, 4320};
+    int n = 0;
+    while (n < MP_ARRAY_SIZE(heights) &&
+           (heights[n] < h || standard_width(heights[n]) < w))
+        n++;
+    return n;
+}
+
+static int height_index(int h)
+{
+    return h == 720 ? 0 : h == 1080 ? 1 : h == 2160 ? 2 : 3;
+}
+
+// Prefers the matching frame rate, then the content's own size, then the
+// smallest standard size it fits in (larger sizes before smaller ones), then
+// progressive over interlaced.
+static const struct dl_mode *find_auto_mode(struct dl_mirror *m, int w, int h,
+                                            double fps)
+{
+    const struct dl_mode *best = NULL;
+    double best_score = INFINITY;
+    int fit = fit_index(w, h);
+
+    for (int n = 0; n < m->out.num_modes; n++) {
+        const struct dl_mode *mode = &m->out.modes[n];
+        double score = 0;
+        if (fps <= 0 || fabs(mode_fps(mode) - fps) > 0.01)
+            score += 1000 + (fps > 0 ? fabs(mode_fps(mode) - fps) * 10 : 0);
+        if (mode->w != standard_width(mode->h))
+            score += 100;
+        if (mode->w != w || mode->h != h) {
+            int d = height_index(mode->h) - fit;
+            score += 10 * (d >= 0 ? 1 + 2 * d : 2 - 2 * d);
+        }
+        if (mode->interlaced)
+            score += 1;
+        if (score < best_score) {
+            best_score = score;
+            best = mode;
+        }
+    }
+    return best;
+}
+
+static void free_ring(struct dl_mirror *m)
+{
+    for (int n = 0; n < RING_SIZE; n++)
+        TA_FREEP(&m->ring[n].img);
+}
+
+static bool alloc_ring(struct dl_mirror *m, const struct dl_mode *mode)
+{
+    bool sd = mode->h < 720;
+    for (int n = 0; n < RING_SIZE; n++) {
+        struct mp_image *img = mp_image_alloc(IMGFMT_UYVY, mode->w, mode->h);
+        if (!img)
+            return false;
+        img->params.repr = (struct pl_color_repr){
+            .sys = sd ? PL_COLOR_SYSTEM_BT_601 : PL_COLOR_SYSTEM_BT_709,
+            .levels = PL_COLOR_LEVELS_LIMITED,
+        };
+        img->params.color = (struct pl_color_space){
+            .primaries = sd ? PL_COLOR_PRIM_BT_601_625 : PL_COLOR_PRIM_BT_709,
+            .transfer = PL_COLOR_TRC_BT_1886,
+        };
+        img->params.chroma_location = PL_CHROMA_LEFT;
+        mp_image_clear(img, 0, 0, img->w, img->h);
+        m->ring[n] = (struct ring_entry){ .img = img };
+    }
+    return true;
+}
+
+static void stop_output(struct dl_mirror *m)
+{
+    if (!m->started)
+        return;
+    m->backend->stop(&m->out);
+    m->started = false;
+    mp_mutex_lock(&m->lock);
+    free_ring(m);
+    mp_mutex_unlock(&m->lock);
+}
+
+// Selects and starts the output mode for the given content.
+static bool configure(struct dl_mirror *m, int w, int h, double fps)
+{
+    const char *user_mode = m->opts->decklink_mode;
+    bool is_auto = !user_mode || !user_mode[0] || strcmp(user_mode, "auto") == 0;
+    const struct dl_mode *mode;
+
+    if (is_auto) {
+        if (m->started && w == m->content_w && h == m->content_h &&
+            fabs(fps - m->content_fps) < 0.001)
+            return true;
+        m->content_w = w;
+        m->content_h = h;
+        m->content_fps = fps;
+        mode = find_auto_mode(m, w, h, fps);
+    } else {
+        if (m->started)
+            return true;
+        mode = find_user_mode(m, user_mode);
+        if (!mode) {
+            MP_ERR(m, "Output mode '%s' not found.\n", user_mode);
+            list_modes(m, MSGL_ERR);
+            m->failed = true;
+            return false;
+        }
+    }
+    if (!mode) {
+        MP_ERR(m, "The device has no output modes.\n");
+        m->failed = true;
+        return false;
+    }
+    if (m->started && mode->id == m->mode.id)
+        return true;
+
+    stop_output(m);
+
+    m->mode = *mode;
+    mp_mutex_lock(&m->lock);
+    bool ok = alloc_ring(m, mode);
+    mp_mutex_unlock(&m->lock);
+    if (!ok || !m->backend->start(&m->out, &m->mode)) {
+        MP_ERR(m, "Could not start output.\n");
+        mp_mutex_lock(&m->lock);
+        free_ring(m);
+        mp_mutex_unlock(&m->lock);
+        m->failed = true;
+        return false;
+    }
+    m->started = true;
+
+    char name[32];
+    mode_short_name(&m->mode, name, sizeof(name));
+    MP_INFO(m, "Output %s (%dx%d) for %dx%d @ %.3f fps.\n", name,
+            m->mode.w, m->mode.h, w, h, fps);
+    return true;
+}
+
+// Scales img into dst, keeping the aspect ratio (square output pixels).
+static bool convert(struct dl_mirror *m, struct mp_image *dst,
+                    struct mp_image *img, int dw, int dh)
+{
+    double scale = MPMIN(dst->w / (double)dw, dst->h / (double)dh);
+    int w = MPCLAMP(lrint(dw * scale / 2) * 2, 2, dst->w);
+    int h = MPCLAMP(lrint(dh * scale), 1, dst->h);
+    int x = (dst->w - w) / 4 * 2;
+    int y = (dst->h - h) / 2;
+    struct mp_rect rc = {x, y, x + w, y + h};
+
+    struct mp_image view = *dst;
+    mp_image_crop_rc(&view, rc);
+    if (mp_sws_scale(m->sws, &view, img) < 0)
+        return false;
+    mp_image_clear_rc_inv(dst, rc);
+    return true;
+}
+
+// Call with lock held. Returns -1 if all entries are still needed.
+static int get_free_entry(struct dl_mirror *m)
+{
+    // Every future slot may use frames due before this; of these only the
+    // newest is still needed.
+    int64_t limit = mp_time_ns() - m->out.fill_ahead_ns - MARGIN_NS - m->delay_ns;
+    int newest = -1;
+    for (int n = 0; n < RING_SIZE; n++) {
+        struct ring_entry *e = &m->ring[n];
+        if (e->valid && e->target <= limit &&
+            (newest < 0 || e->target > m->ring[newest].target))
+            newest = n;
+    }
+    for (int n = 0; n < RING_SIZE; n++) {
+        struct ring_entry *e = &m->ring[n];
+        if (n != newest && e->valid && e->target <= limit)
+            e->valid = false;
+    }
+    for (int n = 0; n < RING_SIZE; n++) {
+        if (!m->ring[n].valid && !m->ring[n].busy)
+            return n;
+    }
+    return -1;
+}
+
+static void process_frame(struct dl_mirror *m, struct pending *p)
+{
+    if (m->failed)
+        return;
+
+    if (!m->opened) {
+        const char *device = m->opts->decklink_mirror;
+        if (!m->backend->open(&m->out, device)) {
+            MP_ERR(m, "Could not open DeckLink device '%s'.\n", device);
+            m->failed = true;
+            return;
+        }
+        m->opened = true;
+        list_modes(m, MSGL_V);
+    }
+
+    struct mp_image *img = p->img;
+    struct mp_image *sw = NULL;
+    if (img->hwctx) {
+        sw = mp_image_hw_download(img, NULL);
+        if (!sw) {
+            MP_ERR(m, "Could not download hardware decoded frame; "
+                   "use --hwdec=auto-copy.\n");
+            m->failed = true;
+            return;
+        }
+        img = sw;
+    }
+
+    int dw, dh;
+    mp_image_params_get_dsize(&img->params, &dw, &dh);
+    double fps = img->nominal_fps;
+    if (fps <= 0 && p->duration > 0)
+        fps = 1e9 / p->duration;
+
+    if (dw < 1 || dh < 1 || !configure(m, dw, dh, fps))
+        goto done;
+
+    mp_mutex_lock(&m->lock);
+    int idx = get_free_entry(m);
+    if (idx >= 0) {
+        m->ring[idx].busy = true;
+        m->ring[idx].valid = false;
+    }
+    mp_mutex_unlock(&m->lock);
+    if (idx < 0)
+        goto done;
+
+    bool ok = convert(m, m->ring[idx].img, img, dw, dh);
+    if (!ok)
+        MP_WARN(m, "Could not convert frame.\n");
+
+    mp_mutex_lock(&m->lock);
+    struct ring_entry *e = &m->ring[idx];
+    e->busy = false;
+    e->valid = ok;
+    e->target = p->target;
+    e->pts = img->pts;
+    // A frame that is shown earlier than already queued ones (e.g. after a
+    // seek) supersedes them.
+    for (int n = 0; ok && n < RING_SIZE; n++) {
+        struct ring_entry *o = &m->ring[n];
+        if (n != idx && o->valid && o->target >= e->target)
+            o->valid = false;
+    }
+    mp_mutex_unlock(&m->lock);
+
+done:
+    talloc_free(sw);
+}
+
+static MP_THREAD_VOID worker_thread(void *ptr)
+{
+    struct dl_mirror *m = ptr;
+    mp_thread_set_name("decklink");
+
+    mp_mutex_lock(&m->lock);
+    while (!m->terminate) {
+        if (!m->num_pending) {
+            mp_cond_wait(&m->wakeup, &m->lock);
+            continue;
+        }
+        struct pending p = m->pending[0];
+        m->num_pending--;
+        memmove(&m->pending[0], &m->pending[1],
+                m->num_pending * sizeof(m->pending[0]));
+        mp_mutex_unlock(&m->lock);
+
+        process_frame(m, &p);
+        talloc_free(p.img);
+
+        mp_mutex_lock(&m->lock);
+    }
+    mp_mutex_unlock(&m->lock);
+
+    stop_output(m);
+    if (m->opened)
+        m->backend->close(&m->out);
+
+    MP_THREAD_RETURN();
+}
+
+double dl_mirror_fill(struct dl_mirror *m, void *dst, ptrdiff_t stride,
+                      int64_t display_time)
+{
+    mp_mutex_lock(&m->lock);
+
+    int64_t limit = display_time - m->out.fill_ahead_ns - MARGIN_NS - m->delay_ns;
+    int best = -1;
+    for (int n = 0; n < RING_SIZE; n++) {
+        struct ring_entry *e = &m->ring[n];
+        if (e->valid && e->target <= limit &&
+            (best < 0 || e->target > m->ring[best].target))
+            best = n;
+    }
+
+    double pts = MP_NOPTS_VALUE;
+    if (best >= 0) {
+        struct ring_entry *e = &m->ring[best];
+        for (int n = 0; n < RING_SIZE; n++) {
+            if (m->ring[n].valid && m->ring[n].target < e->target)
+                m->ring[n].valid = false;
+        }
+        for (int y = 0; y < e->img->h; y++) {
+            memcpy((uint8_t *)dst + y * stride,
+                   e->img->planes[0] + y * e->img->stride[0], e->img->w * 2);
+        }
+        pts = e->pts;
+    } else {
+        static const uint8_t black[4] = {0x80, 0x10, 0x80, 0x10};
+        for (int y = 0; y < m->mode.h; y++) {
+            uint8_t *line = (uint8_t *)dst + y * stride;
+            for (int x = 0; x < m->mode.w / 2; x++)
+                memcpy(line + x * 4, black, 4);
+        }
+    }
+
+    mp_mutex_unlock(&m->lock);
+    return pts;
+}
+
+void dl_mirror_queue(struct dl_mirror *m, struct mp_image *img,
+                     int64_t target, double duration)
+{
+    if (!img || img->params.force_window)
+        return;
+    struct mp_image *ref = mp_image_new_ref(img);
+    if (!ref)
+        return;
+    if (target <= 0)
+        target = mp_time_ns();
+
+    mp_mutex_lock(&m->lock);
+    if (m->num_pending == MAX_PENDING) {
+        talloc_free(m->pending[0].img);
+        m->num_pending--;
+        memmove(&m->pending[0], &m->pending[1],
+                m->num_pending * sizeof(m->pending[0]));
+    }
+    m->pending[m->num_pending++] = (struct pending){
+        .img = ref,
+        .target = target,
+        .duration = duration,
+    };
+    mp_cond_signal(&m->wakeup);
+    mp_mutex_unlock(&m->lock);
+}
+
+struct dl_mirror *dl_mirror_create(struct mpv_global *global,
+                                   struct mp_log *log)
+{
+    struct dl_mirror *m = talloc_zero(NULL, struct dl_mirror);
+    m->global = global;
+    m->log = mp_log_new(m, log, "decklink");
+    m->opts = mp_get_config_group(m, global, &vo_sub_opts);
+    m->delay_ns = MP_TIME_S_TO_NS(m->opts->decklink_delay);
+
+    const char *device = m->opts->decklink_mirror;
+    if (strncmp(device, "dummy", 5) == 0) {
+        m->backend = &dl_backend_dummy;
+    } else {
+#if HAVE_WIN32_DESKTOP
+        m->backend = &dl_backend_win;
+#else
+        MP_ERR(m, "DeckLink output is not supported on this platform.\n");
+        talloc_free(m);
+        return NULL;
+#endif
+    }
+
+    m->out = (struct dl_output){
+        .log = m->log,
+        .mirror = m,
+    };
+    m->sws = mp_sws_alloc(m);
+    m->sws->log = m->log;
+    mp_sws_enable_cmdline_opts(m->sws, global);
+
+    mp_mutex_init(&m->lock);
+    mp_cond_init(&m->wakeup);
+    if (mp_thread_create(&m->thread, worker_thread, m)) {
+        mp_cond_destroy(&m->wakeup);
+        mp_mutex_destroy(&m->lock);
+        talloc_free(m);
+        return NULL;
+    }
+    return m;
+}
+
+void dl_mirror_destroy(struct dl_mirror *m)
+{
+    if (!m)
+        return;
+    mp_mutex_lock(&m->lock);
+    m->terminate = true;
+    mp_cond_signal(&m->wakeup);
+    mp_mutex_unlock(&m->lock);
+    mp_thread_join(m->thread);
+
+    for (int n = 0; n < m->num_pending; n++)
+        talloc_free(m->pending[n].img);
+    mp_cond_destroy(&m->wakeup);
+    mp_mutex_destroy(&m->lock);
+    talloc_free(m);
+}
