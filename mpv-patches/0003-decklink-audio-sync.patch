diff --git a/video/out/decklink/mirror.c b/video/out/decklink/mirror.c
index 938c306..c50eb46 100644
--- a/video/out/decklink/mirror.c
+++ b/video/out/decklink/mirror.c
@@ -74,6 +74,7 @@ struct dl_mirror {
     mp_mutex lock;
     mp_cond wakeup;
     bool terminate;
+    double latency;
     struct pending pending[MAX_PENDING];
     int num_pending;
     struct ring_entry ring[RING_SIZE];
@@ -232,6 +233,7 @@ static void stop_output(struct dl_mirror *m)
     m->started = false;
     mp_mutex_lock(&m->lock);
     free_ring(m);
+    m->latency = 0;
     mp_mutex_unlock(&m->lock);
 }
 
@@ -285,6 +287,14 @@ static bool configure(struct dl_mirror *m, int w, int h, double fps)
     }
     m->started = true;
 
+    // A frame is shown in the first slot at least this much after its VO
+    // display time, on average half a frame later.
+    int64_t frame_ns = MP_TIME_S_TO_NS(m->mode.duration) / m->mode.timescale;
+    mp_mutex_lock(&m->lock);
+    m->latency = MP_TIME_NS_TO_S(m->out.fill_ahead_ns + MARGIN_NS + m->delay_ns +
+                                 frame_ns / 2);
+    mp_mutex_unlock(&m->lock);
+
     char name[32];
     mode_short_name(&m->mode, name, sizeof(name));
     MP_INFO(m, "Output %s (%dx%d) for %dx%d @ %.3f fps.\n", name,
@@ -504,6 +514,14 @@ void dl_mirror_queue(struct dl_mirror *m, struct mp_image *img,
     mp_mutex_unlock(&m->lock);
 }
 
+double dl_mirror_get_latency(struct dl_mirror *m)
+{
+    mp_mutex_lock(&m->lock);
+    double r = m->latency;
+    mp_mutex_unlock(&m->lock);
+    return r;
+}
