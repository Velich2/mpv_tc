diff --git a/player/audio.c b/player/audio.c
index b3e975d..c8f53b7 100644
--- a/player/audio.c
+++ b/player/audio.c
@@ -227,6 +227,28 @@ static void ao_chain_reset_state(struct ao_chain *ao_c)
     ao_c->delaying_audio_start = false;
 }
 
+// --audio-delay, plus the DeckLink output latency with --decklink-audio-sync.
+double get_audio_delay(struct MPContext *mpctx)
+{
+    double delay = mpctx->opts->audio_delay;
+    if (mpctx->opts->vo->decklink_audio_sync && mpctx->video_out)
+        delay += vo_get_decklink_latency(mpctx->video_out);
+    return delay;
+}
+
+// Applies a change of get_audio_delay() to the running audio.
+void update_audio_delay(struct MPContext *mpctx)
+{
+    if (!mpctx->ao_chain)
+        return;
+    double delay = get_audio_delay(mpctx);
+    if (delay != mpctx->ao_chain->delay) {
+        mpctx->delay += delay - mpctx->ao_chain->delay;
+        mpctx->ao_chain->delay = delay;
+        mp_wakeup_core(mpctx);
+    }
+}
+
