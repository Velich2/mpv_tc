diff --git a/video/out/vo.c b/video/out/vo.c
index e94317d..79ef769 100644
--- a/video/out/vo.c
+++ b/video/out/vo.c
@@ -952,6 +952,20 @@ void vo_queue_frame(struct vo *vo, struct vo_frame *frame)
     mp_mutex_unlock(&in->lock);
 }
 
+// Latency of the DeckLink mirror output in seconds (0 if inactive).
+double vo_get_decklink_latency(struct vo *vo)
+{
+    double r = 0;
+#if HAVE_DECKLINK
+    struct vo_internal *in = vo->in;
+    mp_mutex_lock(&in->lock);
+    if (in->dl_mirror)
+        r = dl_mirror_get_latency(in->dl_mirror);
+    mp_mutex_unlock(&in->lock);
+#endif
+    return r;
+}
+
 // If a frame is currently being rendered (or queued), wait until it's done.
 // Otherwise, return immediately.
 void vo_wait_frame(struct vo *vo)
