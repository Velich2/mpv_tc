+// Frame rate of files without a nominal rate, from the timestamps of recent
+// frames queued to the VO. approx is the decoder's average frame duration in
+// seconds (not adjusted for the playback speed). Timestamp gaps from frames
+// dropped by the player count as multiples of it. The current rate is kept
+// unless the estimate is clearly off, which needs a longer span of frames for
+// close rates such as 23.976 and 24 (container timestamps are often rounded
+// to 1 ms). Returns 0 if unknown. Call with lock held.
+static double estimate_fps(struct dl_mirror *m, double pts, double approx)
+{
+    int max = MP_ARRAY_SIZE(m->pts_hist);
+    if (!(approx > 0))
+        return m->est_fps;
+    if (pts != MP_NOPTS_VALUE) {
+        double last = m->num_pts ? m->pts_hist[m->num_pts - 1] : 0;
+        if (m->num_pts && (pts <= last || pts - last > 1))
+            m->num_pts = 0; // seek or discontinuity
+        if (m->num_pts == max) {
+            memmove(&m->pts_hist[0], &m->pts_hist[1], (max - 1) * sizeof(double));
+            m->num_pts--;
+        }
+        m->pts_hist[m->num_pts++] = pts;
+    }
 
