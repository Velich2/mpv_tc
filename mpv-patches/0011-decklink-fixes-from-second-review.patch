-        m->num_durations = MPMIN(m->num_durations + 1, MP_ARRAY_SIZE(m->durations));
+    double fps = 1 / approx, span = 0;
+    int frames = 0;
+    for (int n = 0; n + 1 < m->num_pts; n++) {
+        double diff = m->pts_hist[n + 1] - m->pts_hist[n];
+        long k = lrint(diff / approx);
+        if (k >= 1 && fabs(diff - k * approx) < approx * 0.25) {
+            span += diff;
+            frames += k;
+        }
     }
-    if (!m->num_durations)
-        return 0;
-    double sorted[MP_ARRAY_SIZE(m->durations)];
-    memcpy(sorted, m->durations, m->num_durations * sizeof(sorted[0]));
-    qsort(sorted, m->num_durations, sizeof(sorted[0]), compare_double);
-    return snap_fps(1e9 / sorted[m->num_durations / 2]);
+    if (frames >= 2)
+        fps = frames / span;
+    double margin = frames >= 2 ? MPMAX(0.0005, 0.0015 / span) : 0.01;
+    if (!(m->est_fps > 0 && fabs(fps - m->est_fps) <= m->est_fps * margin))
+        m->est_fps = snap_fps(fps);
+    return m->est_fps;
 }
 
